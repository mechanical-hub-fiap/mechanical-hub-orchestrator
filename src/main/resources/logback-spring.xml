<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logs estruturados (mesma configuracao do monolito, RFC-0004).

    - Producao (qualquer perfil que nao seja `local`/`test`): uma linha JSON
      por evento em stdout, recolhida pelo coletor OpenTelemetry e entregue ao Loki.
    - `local` / `test`: padrao legivel.

  Correlacao: `trace_id`/`span_id` sao colocados no MDC pelo agente Java do
  OpenTelemetry; `orderId`, `transactionId` e `eventId` sao colocados pelo
  consumidor de eventos (junto com currentStep) e pelo relay do outbox.
-->
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="applicationName" source="spring.application.name" defaultValue="mechanical-hub-orchestrator"/>
    <springProperty scope="context" name="environment" source="mechanical-hub.environment" defaultValue="production"/>

    <springProfile name="!local &amp; !test">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <timestamp>
                        <fieldName>timestamp</fieldName>
                        <timeZone>UTC</timeZone>
                    </timestamp>
                    <logLevel>
                        <fieldName>level</fieldName>
                    </logLevel>
                    <loggerName>
                        <fieldName>logger</fieldName>
                        <shortenedLoggerNameLength>40</shortenedLoggerNameLength>
                    </loggerName>
                    <threadName>
                        <fieldName>thread</fieldName>
                    </threadName>
                    <message>
                        <fieldName>message</fieldName>
                    </message>
                    <pattern>
                        <omitEmptyFields>true</omitEmptyFields>
                        <pattern>
                            {
                              "service_name": "${applicationName:-mechanical-hub-orchestrator}",
                              "environment": "${environment:-production}",
                              "trace_id": "%mdc{trace_id:-}",
                              "span_id": "%mdc{span_id:-}",
                              "orderId": "%mdc{orderId:-}",
                              "transactionId": "%mdc{transactionId:-}",
                              "eventId": "%mdc{eventId:-}",
                              "currentStep": "%mdc{currentStep:-}"
                            }
                        </pattern>
                    </pattern>
                    <mdc>
                        <excludeMdcKeyName>trace_id</excludeMdcKeyName>
                        <excludeMdcKeyName>span_id</excludeMdcKeyName>
                        <excludeMdcKeyName>trace_flags</excludeMdcKeyName>
                        <excludeMdcKeyName>orderId</excludeMdcKeyName>
                        <excludeMdcKeyName>transactionId</excludeMdcKeyName>
                        <excludeMdcKeyName>eventId</excludeMdcKeyName>
                        <excludeMdcKeyName>currentStep</excludeMdcKeyName>
                    </mdc>
                    <stackTrace>
                        <fieldName>stack_trace</fieldName>
                        <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                            <maxDepthPerThrowable>25</maxDepthPerThrowable>
                            <maxLength>4096</maxLength>
                            <rootCauseFirst>true</rootCauseFirst>
                        </throwableConverter>
                    </stackTrace>
                </providers>
            </encoder>
        </appender>

        <root level="WARN">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

    <springProfile name="local | test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%X{trace_id:-}] [order=%X{orderId:-} tx=%X{transactionId:-} event=%X{eventId:-} step=%X{currentStep:-}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <logger name="com.fiap.mechanicalhub" level="INFO"/>

</configuration>
